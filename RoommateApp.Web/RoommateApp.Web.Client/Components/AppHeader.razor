@using Radzen
@using Radzen.Blazor
@using RoommateApp.Web.Client
@using RoommateApp.Web.Client.Services
@implements IDisposable
@inject ApartmentStateService ApartmentState
@inject UserSessionService UserSession
@inject UsersClient UsersClient
@inject ChoresClient ChoresClient
@inject NavigationManager Navigation

<!-- Top Header / Navbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

        <!-- Logo & Room name -->
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <RadzenIcon Icon="check_box" Style="font-size: 1.5rem;" />
            </div>
            <div>
                <h1 class="h5 fw-bold m-0 text-dark">ChoreBoard</h1>
                <span class="text-muted small">@ApartmentState.ApartmentName</span>
            </div>
        </div>

        <!-- Navigation buttons -->
        <div class="bg-light p-1 rounded-pill d-none d-md-flex gap-1">
            <button class="btn btn-sm rounded-pill px-3 @(ActivePage == "Board" ? "btn-primary shadow-sm" : "btn-light text-secondary border-0")"
                    @onclick='() => Navigation.NavigateTo("/")'>
                Roommate Board
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(ActivePage == "Stats" ? "btn-primary shadow-sm" : "btn-light text-secondary border-0")"
                    @onclick='() => Navigation.NavigateTo("/stats")'>
                Stats & Analytics
            </button>
            <button class="btn btn-sm rounded-pill px-3 @(ActivePage == "Controls" ? "btn-primary shadow-sm" : "btn-light text-secondary border-0")"
                    @onclick='() => Navigation.NavigateTo("/controls")'>
                Controls
            </button>
        </div>

        <!-- Right-side Notifications, Dynamic Score & Profile Menu -->
        <div class="d-flex align-items-center gap-3">
            

            <!-- Dynamic user score -->
            <div class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background-color: #e0e7ff; color: #4338ca;">
                <RadzenIcon Icon="emoji_events" Style="font-size: 1.2rem; color: #4338ca;" />
                <span class="fw-bold small">@userPoints pts</span>
            </div>

            <!-- Profile picture and menu -->
            <div class="position-relative">
                <button class="btn p-0 border-0 bg-transparent" @onclick="ToggleProfileMenu">
                    <img src="@AvatarUrl"
                         class="rounded-circle shadow-sm border border-2 border-white"
                         style="width: 40px; height: 40px; object-fit: cover; cursor: pointer;"
                         alt="User Profile" />
                </button>

                @if (isProfileMenuOpen)
                {
                    <div class="dropdown-menu dropdown-menu-end show shadow-lg border-0 rounded-4 p-2 position-absolute end-0 mt-2"
                         style="width: 260px; z-index: 1050; background-color: #ffffff;">

                        <div class="px-3 py-2 border-bottom mb-2">
                            <div class="fw-bold small text-dark">@(UserSession.CurrentUser?.Name ?? "Guest")</div>
                            <div class="text-muted extra-small">@(UserSession.CurrentUser?.Email ?? "Not signed in")</div>
                        </div>

                        <!-- Create a new room -->
                        <button class="dropdown-item rounded-3 py-2 extra-small d-flex align-items-center gap-2 mb-1" @onclick="OpenCreateRoomModal">
                            <RadzenIcon Icon="add_circle_outline" Style="font-size: 1.1rem; color: #6366f1;" />
                            <span class="fw-semibold text-dark">Create a new room</span>
                        </button>

                        <!-- NEW: Join a room by code -->
                        <button class="dropdown-item rounded-3 py-2 extra-small d-flex align-items-center gap-2" @onclick="OpenJoinRoomModal">
                            <RadzenIcon Icon="group_add" Style="font-size: 1.1rem; color: #10b981;" />
                            <span class="fw-semibold text-dark">Join a room</span>
                        </button>

                        <div class="dropdown-divider my-2"></div>

                        <!-- List rooms in the profile menu -->
                        <div class="px-3 py-1 text-uppercase text-muted extra-small fw-bold">Your rooms</div>
                        @foreach (var room in myRooms)
                        {
                            <button class="dropdown-item rounded-3 py-2 extra-small d-flex justify-content-between align-items-center mb-1 @(room.Id == ApartmentState.Id ? "bg-primary-subtle text-primary fw-bold" : "text-secondary")"
                                    @onclick="() => SwitchRoom(room.Id)">
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenIcon Icon="home" Style="font-size: 1rem;" />
                                    <span>@room.Name</span>
                                </div>
                                @if (room.Id == ApartmentState.Id)
                                {
                                    <RadzenIcon Icon="check" Style="font-size: 0.9rem; color: #4338ca;" />
                                }
                            </button>
                        }

                        <div class="dropdown-divider my-2"></div>

                        <button class="dropdown-item rounded-3 py-2 extra-small text-danger d-flex align-items-center gap-2" @onclick="Logout">
                            <RadzenIcon Icon="logout" Style="font-size: 1.1rem; color: #ef4444;" />
                            <span class="fw-bold">Sign out</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create a new room modal -->
@if (showCreateRoomModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="modal-title fw-bold text-dark">Create a new room</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateRoomModal"></button>
                </div>
                <div class="modal-body py-2 px-0">
                    <div class="mb-3">
                        <label class="form-label extra-small fw-bold text-secondary">Room / Apartment name</label>
                        <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle"
                               placeholder="e.g. Apartment 5C or Budapest Hideaway" @bind="newRoomNameInput" />
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-2">
                    <button class="btn btn-light btn-sm rounded-pill px-3 extra-small" @onclick="CloseCreateRoomModal">Cancel</button>
                    <button class="btn btn-primary btn-sm rounded-pill px-4 extra-small fw-bold"
                            style="background-color: #6366f1; border: none;" @onclick="CreateNewRoom">
                        Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- NEW: Join a room modal -->
@if (showJoinRoomModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="modal-title fw-bold text-dark">Join a room</h5>
                    <button type="button" class="btn-close" @onclick="CloseJoinRoomModal"></button>
                </div>
                <div class="modal-body py-2 px-0">
                    @if (!string.IsNullOrEmpty(joinRoomErrorMessage))
                    {
                        <div class="alert alert-danger py-2 extra-small mb-3">@joinRoomErrorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label extra-small fw-bold text-secondary">Invite code</label>
                        <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle text-uppercase"
                               placeholder="pl. APT4B-8X92" @bind="joinInviteCodeInput" />
                         <span class="text-muted extra-small mt-1 d-block">Ask the room admin for the 8-character invite code.</span>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 pt-2">
                    <button class="btn btn-light btn-sm rounded-pill px-3 extra-small" @onclick="CloseJoinRoomModal">Cancel</button>
                    <button class="btn btn-success btn-sm rounded-pill px-4 extra-small fw-bold"
                            style="background-color: #10b981; border: none;" @onclick="JoinRoomByCode">
                        Joining
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string ActivePage { get; set; } = "Board";

    private bool isProfileMenuOpen = false;
    private bool showCreateRoomModal = false;
    private bool showJoinRoomModal = false;

    private string newRoomNameInput = string.Empty;
    private string joinInviteCodeInput = string.Empty;
    private string joinRoomErrorMessage = string.Empty;

    private int userPoints = 0;

    private string AvatarUrl => UserSession.CurrentUser != null
        ? $"https://api.dicebear.com/7.x/identicon/svg?seed={UserSession.CurrentUser.Id}"
        : "https://api.dicebear.com/7.x/identicon/svg?seed=default";

    private List<ApartmentDto> myRooms = new();

    protected override async Task OnInitializedAsync()
    {
        ApartmentState.OnChange += StateHasChanged;
        UserSession.OnChange += StateHasChanged;

        await LoadUserApartments();
        await CalculateUserPoints();
    }

    private async Task LoadUserApartments()
    {
        int currentUserId = UserSession.CurrentUser?.Id ?? 1;

        try
        {
            var rooms = await UsersClient.GetUserApartmentsAsync(currentUserId);
            if (rooms != null && rooms.Any())
            {
                myRooms = rooms.ToList();

                if (ApartmentState.Id == 0)
                {
                    var activeRoom = myRooms.First();
                    await ApartmentState.LoadAsync(activeRoom.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while loading apartments: {ex.Message}");
        }
    }

    private async Task CreateNewRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomNameInput)) return;

        int userId = UserSession.CurrentUser?.Id ?? 1;

        try
        {
            var newApt = await UsersClient.CreateApartmentAsync(userId, newRoomNameInput.Trim());
            if (newApt != null)
            {
                await LoadUserApartments();
                await ApartmentState.LoadAsync(newApt.Id);
            }

            CloseCreateRoomModal();
            Navigation.NavigateTo("/", forceLoad: false); // FIXED: Does not reload the browser, so the session is preserved!
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while creating apartment: {ex.Message}");
        }
    }

    private async Task JoinRoomByCode()
    {
        if (string.IsNullOrWhiteSpace(joinInviteCodeInput)) return;

        int userId = UserSession.CurrentUser?.Id ?? 1;
        joinRoomErrorMessage = string.Empty;

        try
        {
            await UsersClient.JoinApartmentAsync(userId, joinInviteCodeInput.Trim().ToUpper());
            await LoadUserApartments();

             // Switch to the newly joined room
            var joinedRoom = myRooms.FirstOrDefault(r => r.InviteCode == joinInviteCodeInput.Trim().ToUpper());
            if (joinedRoom != null)
            {
                await ApartmentState.LoadAsync(joinedRoom.Id);
            }

            CloseJoinRoomModal();
            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            joinRoomErrorMessage = "Invalid invite code or you have already joined this apartment!";
            Console.WriteLine($"Error while joining apartment: {ex.Message}");
        }
    }

    private async Task SwitchRoom(int roomId)
    {
        isProfileMenuOpen = false;
        var room = myRooms.FirstOrDefault(r => r.Id == roomId);
        if (room != null)
        {
            await ApartmentState.LoadAsync(room.Id);
            await CalculateUserPoints();
             Navigation.NavigateTo("/", forceLoad: false); // FIXED: Does not reload the browser!
        }
    }

    private async Task CalculateUserPoints()
    {
        if (UserSession.CurrentUser != null && ApartmentState.Id > 0)
        {
            try
            {
                var chores = await ChoresClient.GetChoresByApartmentAsync(ApartmentState.Id);
                if (chores != null)
                {
                    userPoints = chores
                        .Where(c => c.UserId == UserSession.CurrentUser.Id && c.Status == "Done")
                        .Sum(c => c.Points);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error while calculating user points: {ex.Message}");
            }
        }
    }

    private void ToggleProfileMenu() => isProfileMenuOpen = !isProfileMenuOpen;

    private void OpenCreateRoomModal() { isProfileMenuOpen = false; showCreateRoomModal = true; }
    private void CloseCreateRoomModal() { showCreateRoomModal = false; newRoomNameInput = string.Empty; }

    private void OpenJoinRoomModal() { isProfileMenuOpen = false; showJoinRoomModal = true; joinRoomErrorMessage = string.Empty; }
    private void CloseJoinRoomModal() { showJoinRoomModal = false; joinInviteCodeInput = string.Empty; joinRoomErrorMessage = string.Empty; }

    private void Logout()
    {
        isProfileMenuOpen = false;
        UserSession.Logout();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        ApartmentState.OnChange -= StateHasChanged;
        UserSession.OnChange -= StateHasChanged;
    }
}