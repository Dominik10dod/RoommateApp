@using Radzen
@using Radzen.Blazor
@using RoommateApp.Web.Client.Services
@inject UserSessionService UserSession
@inject ApartmentStateService ApartmentState
@inject UsersClient UsersClient
@inject ChoresClient ChoresClient
@inject NavigationManager Navigation
@inject RealtimeSyncService RealtimeSync
@inject IJSRuntime JS
@implements IDisposable

<div class="mb-3 mb-md-4 border-bottom bg-white rounded-4 px-3 py-2 py-md-3 shadow-sm">
    <!-- Top Row: Brand, Desktop Nav, Points & Profile -->
    <div class="d-flex justify-content-between align-items-center gap-2">
        <!-- Left: Brand / Logo -->
        <div class="d-flex align-items-center gap-2 gap-md-3 min-w-0">
            <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0"
                 style="width: 36px; height: 36px; background-color: #6366f1 !important;">
                <RadzenIcon Icon="done_all" Style="font-size: 1.15rem;" />
            </div>
            <div class="min-w-0">
                <h1 class="h6 h5-md fw-bold m-0 text-dark text-truncate">ChoreBoard</h1>
                <span class="text-muted extra-small d-block text-truncate">@ApartmentState.ApartmentName</span>
            </div>
        </div>

        <!-- Center: Desktop Navigation Links -->
        <div class="d-none d-md-flex align-items-center gap-1 bg-light p-1 rounded-pill border">
            <NavLink href="/" Match="NavLinkMatch.All" class="@($"nav-pill-link {(ActivePage == "Board" ? "active" : "")}")">
                Roommate Board
            </NavLink>
            <NavLink href="/stats" class="@($"nav-pill-link {(ActivePage == "Stats" ? "active" : "")}")">
                Stats & Analytics
            </NavLink>
            <NavLink href="/controls" class="@($"nav-pill-link {(ActivePage == "Controls" ? "active" : "")}")">
                Controls
            </NavLink>
        </div>

        <!-- Right: Points Badge & Profile Dropdown -->
        <div class="d-flex align-items-center gap-2 gap-md-3 position-relative flex-shrink-0">
            <!-- Total Points Badge -->
            <div class="d-flex align-items-center gap-1 px-2 px-md-3 py-1 py-md-2 rounded-pill shadow-sm"
                 style="background-color: #eef2ff; color: #6366f1;">
                <RadzenIcon Icon="emoji_events" Style="font-size: 1rem;" />
                <span class="fw-bold extra-small">@totalUserPoints pts</span>
            </div>

            <!-- Profile Avatar Trigger -->
            <div class="position-relative">
                <button class="btn p-0 border-0 rounded-circle shadow-sm" @onclick="ToggleDropdown"
                        style="width: 38px; height: 38px; overflow: hidden; background-color: #f1f5f9;">
                    <img src="@($"https://api.dicebear.com/7.x/identicon/svg?seed={UserSession.CurrentUser?.Id ?? 1}")"
                         alt="Avatar"
                         class="w-100 h-100 object-fit-cover" />
                </button>

                <!-- Dropdown Menu -->
                @if (isDropdownOpen)
                {
                    <div class="position-absolute end-0 mt-2 bg-white rounded-4 shadow-lg border p-3" style="width: 270px; z-index: 1050;">
                        <!-- User Info Header -->
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="fw-bold text-dark small">@UserSession.CurrentUser?.Name</div>
                            <div class="text-muted extra-small text-truncate">@UserSession.CurrentUser?.Email</div>
                        </div>

                        <!-- Room Actions -->
                        <div class="d-flex flex-column gap-1 mb-3">
                            <button class="btn btn-light text-start btn-sm rounded-3 px-2 py-2 extra-small fw-semibold d-flex align-items-center gap-2 text-dark"
                                    @onclick="OpenCreateModal">
                                <RadzenIcon Icon="add_circle" Style="font-size: 1.1rem; color: #6366f1;" />
                                Create new room
                            </button>
                            <button class="btn btn-light text-start btn-sm rounded-3 px-2 py-2 extra-small fw-semibold d-flex align-items-center gap-2 text-dark"
                                    @onclick="OpenJoinModal">
                                <RadzenIcon Icon="group_add" Style="font-size: 1.1rem; color: #10b981;" />
                                Join room
                            </button>
                        </div>

                        <!-- Rooms List Section -->
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">YOUR ROOMS</div>
                            <div class="d-flex flex-column gap-1 max-h-150 overflow-y-auto">
                                @foreach (var room in userApartments)
                                {
                                    bool isCurrent = room.Id == ApartmentState.Id;
                                    <button class="@($"btn btn-sm text-start rounded-3 px-2 py-2 extra-small d-flex justify-content-between align-items-center {(isCurrent ? "btn-primary text-white" : "btn-light text-dark")}")"
                                            @onclick="() => SwitchRoom(room.Id)">
                                        <div class="d-flex align-items-center gap-2 text-truncate">
                                            <RadzenIcon Icon="home" Style="font-size: 0.95rem;" />
                                            <span class="text-truncate fw-semibold">@room.Name</span>
                                        </div>
                                        @if (isCurrent)
                                        {
                                            <RadzenIcon Icon="check" Style="font-size: 0.95rem;" />
                                        }
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Sign Out -->
                        <button class="btn btn-light text-start btn-sm rounded-3 px-2 py-2 extra-small fw-bold d-flex align-items-center gap-2 text-danger w-100"
                                @onclick="Logout">
                            <RadzenIcon Icon="logout" Style="font-size: 1.1rem;" />
                            Sign out
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Mobile Navigation Tabs (Visible only below md) -->
    <div class="d-flex d-md-none justify-content-around align-items-center mt-2 pt-2 border-top">
        <NavLink href="/" Match="NavLinkMatch.All" class="@($"mobile-nav-tab {(ActivePage == "Board" ? "active" : "")}")">
            <RadzenIcon Icon="check_box" Style="font-size: 1.25rem;" />
            <span>Board</span>
        </NavLink>
        <NavLink href="/stats" class="@($"mobile-nav-tab {(ActivePage == "Stats" ? "active" : "")}")">
            <RadzenIcon Icon="bar_chart" Style="font-size: 1.25rem;" />
            <span>Stats</span>
        </NavLink>
        <NavLink href="/controls" class="@($"mobile-nav-tab {(ActivePage == "Controls" ? "active" : "")}")">
            <RadzenIcon Icon="bolt" Style="font-size: 1.25rem;" />
            <span>Controls</span>
        </NavLink>
    </div>
</div>

<!-- MODAL: CREATE OR JOIN ROOM -->
@if (showActionModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); z-index: 2000; backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered px-3">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 bg-white">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; background-color: #eef2ff !important;">
                        <RadzenIcon Icon="@(isCreatingNewRoom ? "add_business" : "group_add")" Style="font-size: 2rem; color: #6366f1;" />
                    </div>
                    <h4 class="fw-bold text-dark m-0">@(isCreatingNewRoom ? "Create New Room" : "Join Room")</h4>
                    <p class="text-muted small mt-1">@(isCreatingNewRoom ? "Set up a shared household whiteboard." : "Enter your invite code to connect.")</p>
                </div>

                @if (!string.IsNullOrEmpty(modalError))
                {
                    <div class="alert alert-danger py-2 extra-small mb-3 text-center rounded-3">@modalError</div>
                }

                @if (isCreatingNewRoom)
                {
                    <div class="mb-3">
                        <label class="form-label extra-small fw-bold text-secondary">Room Name</label>
                        <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                               placeholder="e.g. Downtown Loft or Apt 4B" @bind="newRoomName" />
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-light rounded-3 py-2 fw-bold flex-fill extra-small text-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary rounded-3 py-2 fw-bold flex-fill extra-small" style="background-color: #6366f1; border: none;" @onclick="ExecuteCreateRoom" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Create Room
                        </button>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label extra-small fw-bold text-secondary">Invite Code</label>
                        <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small text-uppercase"
                               placeholder="e.g. APT4B-8X92" @bind="joinInviteCode" />
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-light rounded-3 py-2 fw-bold flex-fill extra-small text-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-success rounded-3 py-2 fw-bold flex-fill extra-small" style="background-color: #10b981; border: none;" @onclick="ExecuteJoinRoom" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Join Room
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ActivePage { get; set; } = "Board";

    private bool isDropdownOpen = false;
    private List<ApartmentDto> userApartments = new();
    private int totalUserPoints = 0;

    private bool showActionModal = false;
    private bool isCreatingNewRoom = true;
    private string newRoomName = string.Empty;
    private string joinInviteCode = string.Empty;
    private string modalError = string.Empty;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        RealtimeSync.OnBoardUpdated += HandleStateChanged;
        ApartmentState.OnChange += HandleStateChanged;
        UserSession.OnChange += HandleStateChanged;
        UserSession.OnPointsChanged += HandleStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadHeaderDataAsync();
    }

    private async void HandleStateChanged()
    {
        await LoadHeaderDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadHeaderDataAsync()
    {
        if (!UserSession.IsLoggedIn || UserSession.CurrentUser == null) return;

        try
        {
            int currentUserId = UserSession.CurrentUser.Id;
            var rooms = await UsersClient.GetUserApartmentsAsync(currentUserId);
            userApartments = rooms?.ToList() ?? new List<ApartmentDto>();

            int userId = UserSession.CurrentUser?.Id ?? 0;
            if (userId > 0)
            {
                var userRooms = await UsersClient.GetUserApartmentsAsync(userId);
                if (userRooms != null && userRooms.Any())
                {
                    if (ApartmentState.Id == 0 || !userRooms.Any(r => r.Id == ApartmentState.Id))
                    {
                        var savedIdStr = await JS.InvokeAsync<string?>("localStorage.getItem", $"choreboard_selected_apartment_{userId}");
                        int.TryParse(savedIdStr, out int savedApartmentId);

                        var targetRoom = userRooms.FirstOrDefault(r => r.Id == savedApartmentId) ?? userRooms.First();
                        await ApartmentState.LoadAsync(targetRoom.Id);
                    }
                }
            }

            if (ApartmentState.Id > 0)
            {
                await RealtimeSync.JoinApartmentAsync(ApartmentState.Id);
                var allChores = await ChoresClient.GetChoresByApartmentAsync(ApartmentState.Id);
                totalUserPoints = allChores?
                    .Where(c => c.UserId == currentUserId && string.Equals(c.Status, "Done", StringComparison.OrdinalIgnoreCase))
                    .Sum(c => c.Points) ?? 0;
            }
            else
            {
                totalUserPoints = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading header data: {ex.Message}");
        }
    }

    private async Task ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
        if (isDropdownOpen)
        {
            await LoadHeaderDataAsync();
        }
    }

    private async Task SwitchRoom(int apartmentId)
    {
        isDropdownOpen = false;
        if (apartmentId == ApartmentState.Id) return;

        await ApartmentState.LoadAsync(apartmentId);
        int userId = UserSession.CurrentUser?.Id ?? 0;
        if (userId > 0)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"choreboard_selected_apartment_{userId}", apartmentId.ToString());
        }
    }

    private void OpenCreateModal()
    {
        isDropdownOpen = false;
        isCreatingNewRoom = true;
        newRoomName = string.Empty;
        modalError = string.Empty;
        showActionModal = true;
    }

    private void OpenJoinModal()
    {
        isDropdownOpen = false;
        isCreatingNewRoom = false;
        joinInviteCode = string.Empty;
        modalError = string.Empty;
        showActionModal = true;
    }

    private void CloseModal()
    {
        showActionModal = false;
    }

    private async Task ExecuteCreateRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomName))
        {
            modalError = "Please enter a room name!";
            return;
        }

        isSubmitting = true;
        modalError = string.Empty;
        try
        {
            int userId = UserSession.CurrentUser?.Id ?? 1;
            var created = await UsersClient.CreateApartmentAsync(userId, newRoomName.Trim());
            if (created != null)
            {
                showActionModal = false;
                await ApartmentState.LoadAsync(created.Id);
            }
        }
        catch (Exception ex)
        {
            modalError = "Failed to create room.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ExecuteJoinRoom()
    {
        if (string.IsNullOrWhiteSpace(joinInviteCode))
        {
            modalError = "Please enter an invite code!";
            return;
        }

        isSubmitting = true;
        modalError = string.Empty;
        try
        {
            int userId = UserSession.CurrentUser?.Id ?? 1;
            await UsersClient.JoinApartmentAsync(userId, joinInviteCode.Trim().ToUpper());
            var rooms = await UsersClient.GetUserApartmentsAsync(userId);
            var joined = rooms?.FirstOrDefault(r => r.InviteCode == joinInviteCode.Trim().ToUpper()) ?? rooms?.LastOrDefault();

            if (joined != null)
            {
                showActionModal = false;
                await ApartmentState.LoadAsync(joined.Id);
                await RealtimeSync.NotifyBoardUpdatedAsync(joined.Id);
            }
            else
            {
                modalError = "Invalid invite code!";
            }
        }
        catch (Exception ex)
        {
            modalError = "Invalid invite code or already joined.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Logout()
    {
        UserSession.Logout();
        ApartmentState.Reset();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        RealtimeSync.OnBoardUpdated -= HandleStateChanged;
        ApartmentState.OnChange -= HandleStateChanged;
        UserSession.OnChange -= HandleStateChanged;
        UserSession.OnPointsChanged -= HandleStateChanged;
    }
}

