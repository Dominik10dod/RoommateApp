@page "/controls"
@using Radzen
@using Radzen.Blazor
@using RoommateApp.Web.Client
@using RoommateApp.Web.Client.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject UsersClient UsersClient
@inject ChoresClient ChoresClient
@inject ApartmentStateService ApartmentState
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="p-3 p-md-4">
    <!-- Header Component -->
    <AppHeader ActivePage="Controls" />

    <!-- Subheader -->
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold m-0 text-dark">My Dashboard</h2>
            @if (isCurrentUserAdmin)
            {
                <span class="badge bg-danger text-white rounded-pill px-3 py-1 fs-6 fw-bold shadow-sm" style="letter-spacing: 0.5px;">
                    ADMIN
                </span>
            }
        </div>
        <p class="text-muted small m-0 mt-1">View roommates, create chores, and track your contributions.</p>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center justify-content-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading dashboard...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-stretch">
            <!-- Left Column: Roommates, Chore History & Danger Zone (Flexbox amíg a Danger Zone alulra nem zár) -->
            <div class="col-lg-6 d-flex flex-column justify-content-between">

                <div class="d-flex flex-column gap-4">
                    <!-- Card 1: Roommates & Roles -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="h5 fw-bold m-0 text-dark">Roommates & Roles</h3>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold extra-small" @onclick="CopyInviteCode">
                                <RadzenIcon Icon="content_copy" Style="font-size: 0.85rem;" class="me-1" />
                                + Invite Code: @ApartmentState.InviteCode
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(inviteCopiedMessage))
                        {
                            <div class="alert alert-success py-1 px-3 extra-small mb-3">@inviteCopiedMessage</div>
                        }

                        <div class="d-flex flex-column gap-3">
                            @foreach (var roommate in roommates)
                            {
                                bool isMe = roommate.Id == currentUserId;

                                <div class="d-flex justify-content-between align-items-center p-2 rounded-3 hover-bg-light">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@($"https://api.dicebear.com/7.x/identicon/svg?seed={roommate.Id}")"
                                             alt="@roommate.Name"
                                             class="rounded-circle shadow-sm"
                                             style="width: 40px; height: 40px; object-fit: cover; background-color: #f1f5f9;" />
                                        <div>
                                            <h6 class="fw-bold text-dark m-0 small">
                                                @roommate.Name @(isMe ? " (You)" : "")
                                            </h6>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="fw-bold text-dark small">@getUserPoints(roommate.Id) pts</span>
                                        @if (!isMe && isCurrentUserAdmin)
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3 extra-small fw-semibold"
                                                    @onclick="() => ConfirmRemoveUser(roommate)">
                                                Remove
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Card 2: My Chore History -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column" style="height: 480px;">
                        <h3 class="h5 fw-bold m-0 text-dark mb-3">My Chore History</h3>

                        @if (!myHistoryChores.Any())
                        {
                            <div class="d-flex align-items-center justify-content-center flex-grow-1">
                                <p class="text-muted small m-0 text-center">You haven't completed any chores yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3 overflow-y-auto pe-1 flex-grow-1">
                                @foreach (var chore in myHistoryChores)
                                {
                                    string categoryBg = chore.Category switch
                                    {
                                        "CLEANING" => "#dcfce7",
                                        "MAINTENANCE" => "#ffe4e6",
                                        "SHOPPING" => "#fef9c3",
                                        _ => "#e2e8f0"
                                    };

                                    string categoryColor = chore.Category switch
                                    {
                                        "CLEANING" => "#15803d",
                                        "MAINTENANCE" => "#be123c",
                                        "SHOPPING" => "#a16207",
                                        _ => "#475569"
                                    };

                                    <div class="card border rounded-3 p-3 bg-white flex-shrink-0">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-bold px-2 py-1 rounded" style="font-size: 0.65rem; background-color: @categoryBg; color: @categoryColor;">@chore.Category</span>
                                                <span class="text-muted extra-small">Completed @chore.DueDateText</span>
                                            </div>
                                            <span class="fw-bold px-2 py-1 rounded-pill" style="font-size: 0.75rem; background-color: #fef9c3; color: #a16207;">⭐ +@chore.Points pts</span>
                                        </div>
                                        <p class="fw-bold text-dark m-0 small">@chore.Title</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Card 3: Danger Zone (Automatikusan a bal oszlop aljára tolódik, egy vonalba a jobb oldali dobozzal) -->
                @if (isCurrentUserAdmin)
                {
                    <div class="card border border-danger-subtle shadow-sm rounded-4 p-4 bg-white mt-4 mb-0">
                        <div class="d-flex align-items-center gap-2 mb-2 text-danger">
                            <RadzenIcon Icon="warning" Style="font-size: 1.3rem;" />
                            <h3 class="h5 fw-bold m-0">Danger Zone</h3>
                        </div>
                        <p class="text-muted extra-small mb-3">
                            Permanently delete this apartment room. This will remove all assigned roommates, clear all chores, and wipe all room data.
                        </p>
                        <button class="btn btn-outline-danger rounded-3 py-2 fw-bold w-100 extra-small d-flex align-items-center justify-content-center gap-2"
                                @onclick="ConfirmDeleteApartment">
                            <RadzenIcon Icon="delete_forever" Style="font-size: 1.1rem;" />
                            Delete Apartment Room
                        </button>
                    </div>
                }

            </div>

            <!-- Right Column: Apartment Settings & Create Chore -->
            <div class="col-lg-6 d-flex flex-column gap-4">
                
                <!-- Card 4: Apartment Settings -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h5 fw-bold m-0 text-dark mb-4">Apartment Settings</h3>

                    @if (!string.IsNullOrEmpty(settingsMessage))
                    {
                        <div class="alert @(isSettingsSuccess ? "alert-success" : "alert-danger") py-2 extra-small mb-3">
                            @settingsMessage
                        </div>
                    }

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Apartment Name</label>
                            <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                                   @bind="apartmentNameInput" disabled="@(!isCurrentUserAdmin)" />
                        </div>

                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Weekly Reward Threshold (pts)</label>
                            <input type="number" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                                   @bind="rewardThresholdInput" disabled="@(!isCurrentUserAdmin)" min="100" step="100" />
                        </div>

                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Weekly Reward Goal / Title</label>
                            <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                                   placeholder="e.g. Friday Pizza Night! 🍕"
                                   @bind="rewardDescriptionInput" disabled="@(!isCurrentUserAdmin)" />
                        </div>

                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Weekly Streak Reset Schedule</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <select class="form-select rounded-3 py-2 px-3 border-light-subtle extra-small"
                                            @bind="resetDayInput" disabled="@(!isCurrentUserAdmin)">
                                        <option value="Sunday">Sunday</option>
                                        <option value="Monday">Monday</option>
                                        <option value="Tuesday">Tuesday</option>
                                        <option value="Wednesday">Wednesday</option>
                                        <option value="Thursday">Thursday</option>
                                        <option value="Friday">Friday</option>
                                        <option value="Saturday">Saturday</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select rounded-3 py-2 px-3 border-light-subtle extra-small"
                                            @bind="resetHourInput" disabled="@(!isCurrentUserAdmin)">
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            <option value="@i">@i:00</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select rounded-3 py-2 px-3 border-light-subtle extra-small"
                                            @bind="resetAmPmInput" disabled="@(!isCurrentUserAdmin)">
                                        <option value="AM">AM</option>
                                        <option value="PM">PM</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        @if (isCurrentUserAdmin)
                        {
                            <button class="btn btn-primary rounded-3 py-2 fw-bold w-100 mt-2 extra-small"
                                    style="background-color: #6366f1; border: none;"
                                    @onclick="SaveApartmentSettings" disabled="@isSavingSettings">
                                @if (isSavingSettings)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Save Config Settings
                            </button>
                        }
                        else
                        {
                            <p class="text-muted extra-small m-0 text-center italic">Only apartment admins can modify settings.</p>
                        }
                    </div>
                </div>

                <!-- Card 5: Create New Chore -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h3 class="h5 fw-bold m-0 text-dark mb-1">Create New Chore</h3>
                    <p class="text-muted extra-small mb-4">Propose a new chore to the board. Once created, any roommate can claim it.</p>

                    @if (!string.IsNullOrEmpty(createChoreMessage))
                    {
                        <div class="alert @(isCreateChoreSuccess ? "alert-success" : "alert-danger") py-2 extra-small mb-3">
                            @createChoreMessage
                        </div>
                    }

                    <div class="d-flex flex-column gap-3">
                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Chore Title</label>
                            <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                                   placeholder="e.g. Deep clean oven & microwave" @bind="newChoreTitle" />
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label extra-small fw-bold text-secondary mb-1">Category</label>
                                <select class="form-select rounded-3 py-2 px-3 border-light-subtle extra-small" @bind="newChoreCategory">
                                    <option value="CLEANING">CLEANING</option>
                                    <option value="MAINTENANCE">MAINTENANCE</option>
                                    <option value="SHOPPING">SHOPPING</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label extra-small fw-bold text-secondary mb-1">Points</label>
                                <input type="number" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small"
                                       @bind="newChorePoints" min="5" step="5" />
                            </div>
                        </div>

                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Due Date</label>
                            <RadzenDatePicker @bind-Value="newChoreDueDate"
                                              DateFormat="MMM dd, yyyy"
                                              Min="DateTime.Today"
                                              Class="w-100 rounded-3 border-light-subtle custom-datepicker"
                                              Placeholder="Select due date from calendar" />
                        </div>

                        <button class="btn btn-primary rounded-3 py-2 fw-bold w-100 mt-2 extra-small"
                                style="background-color: #6366f1; border: none;"
                                @onclick="CreateChore" disabled="@isCreatingChore">
                            @if (isCreatingChore)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Create & Add to Board
                        </button>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

<!-- CONFIRM REMOVE ROOMMATE MODAL -->
@if (showRemoveConfirmModal && userToRemove != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.7); z-index: 2000; backdrop-filter: blur(3px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 bg-white">
                <div class="text-center mb-3">
                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                        <RadzenIcon Icon="person_remove" Style="font-size: 2rem; color: #ef4444;" />
                    </div>
                    <h4 class="fw-bold text-dark m-0">Remove Roommate</h4>
                    <p class="text-muted small mt-2">
                        Are you sure you want to remove <strong>@userToRemove.Name</strong> from this apartment room?
                    </p>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-light rounded-3 py-2 fw-bold flex-fill extra-small text-secondary" @onclick="CancelRemoveUser">
                        Cancel
                    </button>
                    <button class="btn btn-danger rounded-3 py-2 fw-bold flex-fill extra-small"
                            @onclick="ExecuteRemoveUser" disabled="@isRemovingUser">
                        @if (isRemovingUser)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Yes, Remove
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CONFIRM DELETE APARTMENT MODAL -->
@if (showDeleteApartmentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); z-index: 2050; backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 bg-white">
                <div class="text-center mb-3">
                    <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <RadzenIcon Icon="delete_forever" Style="font-size: 2.2rem;" />
                    </div>
                    <h4 class="fw-bold text-dark m-0">Delete Apartment Room?</h4>
                    <p class="text-muted small mt-2">
                        Are you sure you want to permanently delete <strong>@ApartmentState.ApartmentName</strong>?
                        This action will remove all roommates, delete all chores, and erase room history. <strong>This action cannot be undone.</strong>
                    </p>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light rounded-3 py-2 fw-bold flex-fill extra-small text-secondary"
                            @onclick="() => showDeleteApartmentModal = false">
                        Cancel
                    </button>
                    <button class="btn btn-danger rounded-3 py-2 fw-bold flex-fill extra-small"
                            @onclick="ExecuteDeleteApartment" disabled="@isDeletingApartment">
                        @if (isDeletingApartment)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Yes, Delete Room
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    private int currentUserId = 1;
    private int currentApartmentAdminId = 1;
    private bool isCurrentUserAdmin = true;

    private List<UserDto> roommates = new();
    private List<ChoreDto> allApartmentChores = new();
    private List<ChoreDto> myHistoryChores = new();

    // Apartment Settings Form
    private string apartmentNameInput = string.Empty;
    private int rewardThresholdInput = 5000;
    private string rewardDescriptionInput = "Friday Pizza Night! 🍕";

    // Split Reset Schedule
    private string resetDayInput = "Sunday";
    private int resetHourInput = 12;
    private string resetAmPmInput = "AM";

    private bool isSavingSettings = false;
    private string settingsMessage = string.Empty;
    private bool isSettingsSuccess = true;
    private string inviteCopiedMessage = string.Empty;

    // Create Chore Form
    private string newChoreTitle = string.Empty;
    private string newChoreCategory = "CLEANING";
    private int newChorePoints = 15;
    private DateTime? newChoreDueDate = DateTime.Today;

    private bool isCreatingChore = false;
    private string createChoreMessage = string.Empty;
    private bool isCreateChoreSuccess = true;

    // Remove User Modal
    private bool showRemoveConfirmModal = false;
    private UserDto? userToRemove;
    private bool isRemovingUser = false;

    // Delete Apartment Modal
    private bool showDeleteApartmentModal = false;
    private bool isDeletingApartment = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        currentUserId = UserSession.CurrentUser?.Id ?? 1;
        ApartmentState.OnChange += OnApartmentStateChanged;

        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        isLoading = true;
        try
        {
            if (ApartmentState.Id > 0)
            {
                apartmentNameInput = ApartmentState.ApartmentName;
                rewardThresholdInput = ApartmentState.RewardThreshold;
                rewardDescriptionInput = string.IsNullOrWhiteSpace(ApartmentState.RewardDescription) ? "Friday Pizza Night! 🍕" : ApartmentState.RewardDescription;

                if (!string.IsNullOrWhiteSpace(ApartmentState.ResetSchedule))
                {
                    var parts = ApartmentState.ResetSchedule.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length >= 1) resetDayInput = parts[0];
                    if (parts.Length >= 2)
                    {
                        var timePart = parts[1];
                        var hourStr = timePart.Split(':')[0];
                        if (int.TryParse(hourStr, out int h))
                        {
                            resetHourInput = Math.Clamp(h, 1, 12);
                        }
                    }
                    if (parts.Length >= 3)
                    {
                        resetAmPmInput = parts[2].ToUpper().Contains("PM") ? "PM" : "AM";
                    }
                }

                var users = await UsersClient.GetUsersByApartmentAsync(ApartmentState.Id);
                roommates = users.ToList();

                var chores = await ChoresClient.GetChoresByApartmentAsync(ApartmentState.Id);
                allApartmentChores = chores.ToList();

                myHistoryChores = allApartmentChores
                    .Where(c => c.UserId == currentUserId && c.Status == "Done")
                    .ToList();

                isCurrentUserAdmin = roommates.Any(r => r.Id == currentUserId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading controls dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private int getUserPoints(int userId)
    {
        return allApartmentChores
            .Where(c => c.UserId == userId && c.Status == "Done")
            .Sum(c => c.Points);
    }

    private void CopyInviteCode()
    {
        inviteCopiedMessage = $"Invite Code copied: {ApartmentState.InviteCode}";
    }

    private void ConfirmRemoveUser(UserDto user)
    {
        userToRemove = user;
        showRemoveConfirmModal = true;
    }

    private void CancelRemoveUser()
    {
        userToRemove = null;
        showRemoveConfirmModal = false;
    }

    private async Task ExecuteRemoveUser()
    {
        if (userToRemove == null) return;

        isRemovingUser = true;
        try
        {
            roommates.Remove(userToRemove);
            showRemoveConfirmModal = false;
            userToRemove = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing user: {ex.Message}");
        }
        finally
        {
            isRemovingUser = false;
        }
    }

    private async Task SaveApartmentSettings()
    {
        isSavingSettings = true;
        settingsMessage = string.Empty;

        try
        {
            string fullSchedule = $"{resetDayInput} {resetHourInput}:00 {resetAmPmInput}";
            await ApartmentState.SaveAsync(apartmentNameInput, rewardThresholdInput, rewardDescriptionInput, fullSchedule);

            isSettingsSuccess = true;
            settingsMessage = "Apartment settings saved successfully! Goal & Schedule updated live.";
        }
        catch (Exception ex)
        {
            isSettingsSuccess = false;
            settingsMessage = "Failed to save settings. Please try again.";
            Console.WriteLine($"Error updating apartment settings: {ex.Message}");
        }
        finally
        {
            isSavingSettings = false;
        }
    }

    private async Task CreateChore()
    {
        if (string.IsNullOrWhiteSpace(newChoreTitle))
        {
            isCreateChoreSuccess = false;
            createChoreMessage = "Please enter a chore title!";
            return;
        }

        isCreatingChore = true;
        createChoreMessage = string.Empty;

        try
        {
            string dueDateStr = newChoreDueDate.HasValue
                ? newChoreDueDate.Value.ToString("MMM dd", CultureInfo.CreateSpecificCulture("en-US"))
                : "Today";

            var dto = new CreateChoreDto
            {
                Title = newChoreTitle.Trim(),
                Category = newChoreCategory,
                Points = newChorePoints,
                ApartmentId = ApartmentState.Id,
                DueDateText = dueDateStr
            };

            await ChoresClient.CreateChoreAsync(dto);

            isCreateChoreSuccess = true;
            createChoreMessage = "Chore created and added to the board!";

            newChoreTitle = string.Empty;
            newChorePoints = 15;
            newChoreDueDate = DateTime.Today;

            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            isCreateChoreSuccess = false;
            createChoreMessage = "Failed to create chore. Please try again.";
            Console.WriteLine($"Error creating chore: {ex.Message}");
        }
        finally
        {
            isCreatingChore = false;
        }
    }

    private void ConfirmDeleteApartment()
    {
        showDeleteApartmentModal = true;
    }

    private async Task ExecuteDeleteApartment()
    {
        isDeletingApartment = true;

        try
        {
            await ApartmentState.DeleteApartmentAsync();
            showDeleteApartmentModal = false;

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting apartment: {ex.Message}");
        }
        finally
        {
            isDeletingApartment = false;
        }
    }

    private async void OnApartmentStateChanged()
    {
        await LoadDashboardDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ApartmentState.OnChange -= OnApartmentStateChanged;
    }
}

<style>
    .extra-small {
        font-size: 0.75rem;
    }

    .hover-bg-light:hover {
        background-color: #f8fafc;
    }

    .custom-datepicker input {
        border-radius: 0.5rem !important;
        font-size: 0.75rem !important;
        padding: 0.5rem 0.75rem !important;
    }
</style>