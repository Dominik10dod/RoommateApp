@page "/login"
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Web
@using RoommateApp.Web.Client
@using RoommateApp.Web.Client.Services
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject UsersClient UsersClient
@inject NavigationManager Navigation
@inject UserSessionService UserSession
@inject ApartmentStateService ApartmentState

<div class="auth-container d-flex flex-column justify-content-center p-3 p-md-4 min-vh-100">
    <!-- Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                <RadzenIcon Icon="check_box" Style="font-size: 1.2rem;" />
            </div>
            <span class="fw-bold fs-5 text-dark">ChoreBoard</span>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row align-items-center my-auto g-4">
        <!-- Left Hero Section -->
        <div class="col-lg-6">
            <h1 class="display-6 fw-bold text-dark lh-sm mb-3">
                Keep your home clean,<br />
                rewards high, and<br />
                roommates happy.
            </h1>
            <p class="text-secondary fs-6 mb-4 style-max-width">
                The chore tracking app designed specifically for shared households. Track weekly tasks, claim high-value chores, and compete for Friday night rewards.
            </p>

            <!-- Bottom Left Widget Box -->
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white style-max-width">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="bg-warning-subtle p-2 rounded-3 text-warning">
                        <RadzenIcon Icon="star_outline" Style="font-size: 1.3rem;" />
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark m-0">Friday Pizza Night is unlocked!</h6>
                        <span class="text-muted small">Collective points reach 5,240 / 5,000 pts this week.</span>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <div class="bg-light p-2 rounded-3 d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5 text-primary">14</span>
                            <span class="text-muted extra-small fw-semibold">Chores Completed</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-light p-2 rounded-3 d-flex align-items-center gap-2">
                            <span class="fw-bold fs-5 text-success">5d</span>
                            <span class="text-muted extra-small fw-semibold">Active Clean Streak</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Auth Form Card -->
        <div class="col-lg-5 offset-lg-1">
            <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
                <!-- Tab Selector (Sign In / Sign Up) -->
                <div class="bg-light p-1 rounded-pill d-flex mb-3">
                    <button class="btn btn-sm rounded-pill flex-fill fw-bold @(isSignIn ? "btn-white shadow-sm text-dark" : "btn-light text-secondary border-0")"
                            @onclick="() => SetTab(true)">
                        Sign In
                    </button>
                    <button class="btn btn-sm rounded-pill flex-fill fw-bold @(!isSignIn ? "btn-white shadow-sm text-dark" : "btn-light text-secondary border-0")"
                            @onclick="() => SetTab(false)">
                        Sign Up
                    </button>
                </div>

                <!-- Form Header -->
                <h4 class="fw-bold text-dark mb-1">@(isSignIn ? "Welcome back" : "Create an account")</h4>
                <p class="text-muted extra-small mb-3">
                    @(isSignIn ? "Enter your room credentials to view the whiteboard." : "Fill in your details to join your roommate board.")
                </p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 extra-small mb-3">@errorMessage</div>
                }

                <!-- Dynamic Form Fields -->
                <div class="d-flex flex-column gap-2">
                    @if (!isSignIn)
                    {
                        <div>
                            <label class="form-label extra-small fw-bold text-secondary mb-1">Teljes Név</label>
                            <input type="text" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small" placeholder="Kovács Péter" @bind="nameInput" />
                        </div>
                    }

                    <div>
                        <label class="form-label extra-small fw-bold text-secondary mb-1">E-mail cím</label>
                        <input type="email" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small" placeholder="peter@example.com" @bind="emailInput" />
                    </div>

                    <div>
                        <label class="form-label extra-small fw-bold text-secondary mb-1">Jelszó</label>
                        <input type="password" class="form-control rounded-3 py-2 px-3 border-light-subtle extra-small" placeholder="••••••••" @bind="passwordInput" />
                    </div>

                    <!-- Submit Button -->
                    <button class="btn btn-primary rounded-3 py-2 fw-bold w-100 mt-2 extra-small"
                            style="background-color: #6366f1; border: none;"
                            @onclick="HandleSubmit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        @(isSignIn ? "Sign In" : "Sign Up")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isSignIn = true;
    private bool isSubmitting = false;

    private string nameInput = string.Empty;
    private string emailInput = string.Empty;
    private string passwordInput = string.Empty;
    private string errorMessage = string.Empty;

    private void SetTab(bool signIn)
    {
        isSignIn = signIn;
        errorMessage = string.Empty;
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        isSubmitting = true;

        try
        {
            if (isSignIn)
            {
                var result = await UsersClient.LoginAsync(new LoginDto
                {
                    Email = emailInput,
                    Password = passwordInput
                });

                if (result != null)
                {
                    UserSession.SetUser(result);

                    var userRooms = await UsersClient.GetUserApartmentsAsync(result.Id);
                    if (userRooms != null && userRooms.Any())
                    {
                        await ApartmentState.LoadAsync(userRooms.First().Id);
                    }

                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(nameInput))
                {
                    errorMessage = "Kérjük, add meg a nevedet!";
                    return;
                }

                var registeredUser = await UsersClient.RegisterAsync(new RegisterDto
                {
                    Name = nameInput,
                    Email = emailInput,
                    Password = passwordInput
                });

                if (registeredUser != null)
                {
                    UserSession.SetUser(registeredUser);
                    Navigation.NavigateTo("/");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A művelet nem sikerült! Ellenőrizd az adataidat.";
            Console.WriteLine($"Auth Hiba: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

<style>
    .auth-container {
        min-height: 100vh;
        background-color: #f8fafc;
    }

    .style-max-width {
        max-width: 520px;
    }

    .btn-white {
        background-color: #ffffff;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>