@page "/test-users"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject RoommateApp.Bll.Services.UserService UserService

<h3>Adatbázis Teszt Oldal (Direkt Bll hívással)</h3>

@if (users == null)
{
    <p>Adatok betöltése az adatbázisból...</p>
}
else if (!users.Any())
{
    <p>Az adatbázis üres! (Még nincsenek felhasználók a User táblában.)</p>
}
else
{
    <ul>
        @foreach (var user in users)
        {
            <li>ID: @user.Id – Név: @user.Name (Email: @user.Email)</li>
        }
    </ul>
}

@code {
    private List<RoommateApp.Bll.DTOs.UserDto>? users;

    protected override async Task OnInitializedAsync()
    {
        // Közvetlenül meghívjuk a Bll szolgáltatást, ami lekéri az adatot az adatbázisból
        users = await UserService.GetUsersAsync();
    }
}